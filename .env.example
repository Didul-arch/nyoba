# Login (satu pengguna)
APP_USER=deedol
# hash argon2id, BUKAN password asli
APP_PASSWORD_HASH=
# string acak >= 32 karakter, misal: openssl rand -base64 48
SESSION_SECRET=

# Lokasi data
VAULT_PATH=./vault
DATA_PATH=./.data

# Cuma buat di VPS (di belakang Caddy). Lokal pakai `npm run dev`, ini nggak perlu.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
