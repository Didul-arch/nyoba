# Login (satu pengguna)
APP_USER=deedol
# hash argon2id, BUKAN password asli. Wajib pakai kutip tunggal: '$argon2id$...'
APP_PASSWORD_HASH=
# string acak >= 32 karakter, misal: openssl rand -base64 48
SESSION_SECRET=

# Lokasi data
VAULT_PATH=./vault
DATA_PATH=./.data

# Opsional: repo Git PRIVAT buat cadangan vault (tarik pas nyala, push tiap commit).
# Kosongin kalau vault cukup di laptop ini. Lihat README → "Cadangan otomatis ke GitHub".
VAULT_REMOTE=

# Cuma buat deploy pakai Docker (compose.yaml): domain yang diarahkan ke VPS.
# Caddy otomatis bikin sertifikat HTTPS buat domain ini.
DOMAIN=nyoba.domainmu.com
