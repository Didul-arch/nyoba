{
	"name": "nyoba",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"knip": "knip",
		"verify": "npm run lint && npm run check && npm run knip && npm test",
		"start": "node --env-file-if-exists=.env build",
		"hash-password": "node scripts/hash-password.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "6.41.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.13"
	},
	"dependencies": {
		"@node-rs/argon2": "2.2.2",
		"@tiptap/core": "3.31.4",
		"@tiptap/extension-list": "3.31.4",
		"@tiptap/extension-table": "3.31.4",
		"@tiptap/extensions": "3.31.4",
		"@tiptap/markdown": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/starter-kit": "3.31.4",
		"better-sqlite3": "13.0.3",
		"yaml": "2.9.1"
	},
	"allowScripts": {
		"better-sqlite3": false
	}
}
